# Copy to .env.local and fill in. .env.local is gitignored.

# --- Envoi SMTP -------------------------------------------------------------
# Compte qui envoie. Pour Gmail / Google Workspace, laissez SMTP_HOST et
# SMTP_PORT tels quels.
SMTP_USER=

# MOT DE PASSE D'APPLICATION, jamais le mot de passe du compte Google.
# Générez-le sur https://myaccount.google.com/apppasswords (la validation en
# deux étapes doit être active). 16 caractères, révocable séparément.
SMTP_PASSWORD=

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465

# --- Destinataire -----------------------------------------------------------
# Où arrivent les audits. Plusieurs adresses séparées par des virgules.
SUBMISSIONS_EMAIL_TO=

# Expéditeur affiché. Par défaut « OSS Checklist <SMTP_USER> ». Gmail réécrit
# une adresse d'expéditeur qui n'est pas celle du compte authentifié.
SUBMISSIONS_EMAIL_FROM=
