# Copy to .env.local and fill in. .env.local is gitignored.

# Resend API key — https://resend.com/api-keys
RESEND_API_KEY=

# Where each submission is mailed. Comma-separated for several recipients.
SUBMISSIONS_EMAIL_TO=

# Sender. Resend's shared onboarding@resend.dev works without setup but only
# delivers to the address that owns the Resend account; use a verified domain
# to mail anywhere else.
SUBMISSIONS_EMAIL_FROM="OSS Checklist <onboarding@resend.dev>"
